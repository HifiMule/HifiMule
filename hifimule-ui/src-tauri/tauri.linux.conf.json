{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "license": "GPL-2.0-only",
    "homepage": "https://github.com/HifiMule/HifiMule",
    "targets": ["deb", "appimage", "rpm"],
    "resources": {
      "bundled-libs/*": "bundled-libs/"
    },
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/hifimule-daemon.desktop": "linux/hifimule-daemon.desktop"
        }
      },
      "rpm": {
        "files": {
          "/etc/xdg/autostart/hifimule-daemon.desktop": "linux/hifimule-daemon.desktop"
        },
        "recommends": ["gnome-shell-extension-appindicator"],
        "depends": ["gtk3", "webkit2gtk4.1", "libsoup3", "libappindicator-gtk3", "libmtp", "openssl-libs", "libxdo"]
      },
      "appimage": {
        "files": {
          "usr/lib": "bundled-libs"
        }
      }
    }
  }
}
