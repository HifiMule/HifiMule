<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <CustomAction Id="StopHifiMuleDaemon"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]hifimule-daemon.exe&quot; --quit"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="RegisterHifiMuleShortcutIdentity"
                  Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]hifimule-daemon.exe&quot; --set-shortcut-appid &quot;[ApplicationProgramsFolder]HifiMule.lnk&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="StopHifiMuleDaemon" Before="InstallValidate">Installed</Custom>
      <Custom Action="RegisterHifiMuleShortcutIdentity" After="CreateShortcuts">NOT REMOVE</Custom>
    </InstallExecuteSequence>
    <!--
      Register hifimule-daemon as a startup application via Registry Run key.
      Runs in the user's interactive session (HKCU) for full tray icon support.
      WiX automatically removes the registry entry on uninstall.
    -->
    <ComponentGroup Id="StartupRegistryGroup">
      <Component Id="StartupRegistryComponent"
                 Directory="INSTALLDIR"
                 Guid="1ba6130d-4fab-4dd0-b5cb-35477b1b5f4e">
        <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="HifiMule"
          Type="string"
          Value="[INSTALLDIR]hifimule-daemon.exe"
          KeyPath="yes" />
      </Component>
      <Component Id="InstallDiscoveryRegistryComponent"
                 Directory="INSTALLDIR"
                 Guid="2d67b0f8-cce7-4c9d-a56a-e34c2ba3ac41">
        <RegistryValue
          Root="HKCU"
          Key="Software\HifiMule"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLDIR]"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
